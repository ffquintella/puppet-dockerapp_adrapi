<%- | Enum['Error', 'Warning', 'Information', 'Debug', 'Trace'] $log_level,
      String $allowed_hosts,
      Boolean $ssl,
      Integer $max_results,
      Integer $pool_size,
      String $search_base,
      String $search_filter,
      String $admin_cn,
      Array[String] $servers,
      String $certificate_file,
      String $database_file,
      String $seed_file,
      String $legacy_json_file,
      String $ldap_pin_store,
      Integer $rate_limit_permit,
      Integer $rate_limit_window_seconds,
      Integer $rate_limit_segments_per_window,
      String $default_domain,
      Optional[String] $ldap_domain,
      Optional[Hash] $entra_domains
| -%>
<%# adrapi >= 1.10.0 configures its directories under the backend-neutral `directories`
    section (see adrapi docs/DIRECTORIES_CONFIG.md): LDAP is one `kind` among peers rather
    than the section everything else hangs off. The deprecated top-level `ldap` section is
    deliberately not emitted - adrapi still reads it, but it is removed in adrapi 2.0.0. -%>
<%# Render the Entra ID domains as a JSON fragment. The whole transform (incl. the
    lambda braces) is kept inside this single code tag so it is opaque to the test
    harness's lightweight EPP renderer; real Puppet evaluates it normally. Secrets
    (clientSecret / certificatePassword) are deliberately never emitted here. The
    fragment carries its own trailing separator so the LDAP domain, rendered last as
    literal text below, stays readable. -%>
<%- $entra_entries = $entra_domains ? {
      undef   => '',
      default => $entra_domains.map |$name, $d| {
        $entra = {
          'tenantId'           => $d['tenant_id'],
          'clientId'           => $d['client_id'],
          'grantedPermissions' => $d['granted_permissions'],
          'authorityHost'      => $d['authority_host'],
          'graphBaseUrl'       => $d['graph_base_url'],
          'scopes'             => $d['scopes'],
          'certificatePath'    => $d['certificate_path'],
        }.filter |$k, $v| { $v =~ NotUndef }
        "\"${name}\": ${to_json({ 'kind' => 'entraid', 'entra' => $entra })}"
      }.join(', '),
    } -%>
<%- $entra_json = ($entra_entries == '' or $ldap_domain == undef) ? {
      true    => $entra_entries,
      default => "${entra_entries}, ",
    } -%>
{
  "Logging": {
    "LogLevel": {
      "Default": "<%= $log_level %>"
    }
  },
  "AllowedHosts": "<%= $allowed_hosts %>",
  "certificate": {
    "file": "<%= $certificate_file %>"
  },
  "directories": {
    "defaultDomain": "<%= $default_domain %>",
    "domains": { <%= $entra_json %><% if $ldap_domain { -%>
"<%= $ldap_domain %>": {
      "kind": "ldap",
      "ldap": {
        "servers": [ <%= $servers.map |$x| { "\"${x}\"" }.join(', ') %> ],
        "ssl": <%= $ssl ? {
          true  => 'true',
          false => 'false',
        } %>,
        "poolSize": <%= $pool_size %>,
        "searchBase": "<%= $search_base %>",
        "searchFilter": "<%= $search_filter %>",
        "maxResults": <%= $max_results %>,
        "adminCn": "<%= $admin_cn %>",
        "trustedCertificatesFile": "<%= $ldap_pin_store %>"
      }
    }<% } -%>
 }
  },
  "security": {
    "databaseFile": "<%= $database_file %>",
    "seedFile": "<%= $seed_file %>",
    "legacyJsonFile": "<%= $legacy_json_file %>"
  },
  "rateLimit": {
    "auth": {
      "permitLimit": <%= $rate_limit_permit %>,
      "windowSeconds": <%= $rate_limit_window_seconds %>,
      "segmentsPerWindow": <%= $rate_limit_segments_per_window %>
    }
  }
}
